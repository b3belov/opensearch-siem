{
  "data_stream": {},
  "index_patterns": [
    "logs-acme-windows-sysmon-quarantine"
  ],
  "priority": 300,
  "template": {
    "mappings": {
      "dynamic": true,
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "customer": {
          "properties": {
            "slug": {
              "type": "keyword"
            }
          }
        },
        "event": {
          "properties": {
            "dataset": {
              "type": "keyword"
            },
            "ingested": {
              "type": "date"
            },
            "original": {
              "type": "wildcard"
            }
          }
        },
        "source": {
          "properties": {
            "id": {
              "type": "keyword"
            }
          }
        }
      }
    },
    "settings": {
      "index.number_of_replicas": 0,
      "index.number_of_shards": 1,
      "plugins.index_state_management.policy_id": "quarantine-7d"
    }
  }
}
